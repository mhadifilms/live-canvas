{
  "context": {
    "id": "example-feature",
    "label": "Designing a feature",
    "description": "Proposed interaction contract. Checks are personal review notes, not automated test results."
  },
  "title": "Save draft before leaving",
  "sections": [
    {
      "id": "behavior",
      "title": "Intended behavior",
      "blocks": [
        {
          "id": "contract",
          "type": "text",
          "text": "An accidental navigation should not erase an unfinished draft. On return, offer **Restore draft** and **Discard** so recovery stays a deliberate choice."
        }
      ]
    },
    {
      "id": "implementation",
      "title": "States to design",
      "blocks": [
        {
          "id": "states",
          "type": "table",
          "columns": [
            "Situation",
            "What the user sees"
          ],
          "rows": [
            [
              "Saved draft available",
              "A preview and Restore / Discard actions."
            ],
            [
              "Draft belongs to another document",
              "No automatic replacement of the current document."
            ],
            [
              "Storage unavailable",
              "An honest notice that the draft cannot be saved locally."
            ]
          ]
        }
      ]
    },
    {
      "id": "checks",
      "title": "Checks to perform",
      "blocks": [
        {
          "id": "validation",
          "type": "checklist",
          "items": [
            {
              "text": "Verify draft recovery after navigation.",
              "checked": false
            },
            {
              "text": "Verify discard removes the saved draft.",
              "checked": false
            }
          ]
        }
      ]
    }
  ]
}
